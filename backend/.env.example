# Copy thành .env (đã được .gitignore). Biến môi trường thật luôn ưu tiên hơn file này.

# --- Web ---
HTTP_ADDR=:8080
# Thư mục front-end. Để trống = tự tìm ../frontend, ./frontend, /app/frontend
STATIC_DIR=
# Nếu đặt, POST /api/command cần header "Authorization: Bearer <token>". Để trống = không cần (chỉ dùng trong LAN).
API_TOKEN=
# Origin được phép gọi API từ trang khác (vd dev server của front-end), cách nhau bằng dấu phẩy.
# Để trống = chỉ cùng origin (mặc định an toàn khi backend tự phục vụ front-end). Tránh dùng "*".
CORS_ORIGINS=

# --- MQTT (Mosquitto local, xem deploy/) ---
MQTT_URL=tcp://localhost:1883
MQTT_USER=backend
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=pkg/awning01/
MQTT_CLIENT_ID=awning-backend

# --- Dữ liệu ---
DB_PATH=./awning.db
HISTORY_RETENTION=168h
# Khoảng cách tối thiểu giữa 2 dòng lịch sử được lưu (chuyển trạng thái luôn được lưu)
HISTORY_INTERVAL=1m

# --- Thời tiết (Open-Meteo, miễn phí, không cần key) ---
# Mặc định: Hà Nội
WEATHER_LAT=21.0285
WEATHER_LON=105.8542
WEATHER_LOCATION=Hà Nội
# Để trống = https://api.open-meteo.com. Đặt khi tự host Open-Meteo hoặc khi kiểm thử với nguồn giả.
WEATHER_BASE_URL=
WEATHER_POLL_INTERVAL=5m
# Gửi lại thời tiết xuống ESP32 định kỳ (heartbeat)
WEATHER_PUBLISH_INTERVAL=1m

# --- Khác ---
# Quá thời gian này không có telemetry thì coi thiết bị offline
DEVICE_TIMEOUT=20s
LOG_LEVEL=info
